# ─────────────────────────────────────────────────────────────
#  CareBabyStore Baby Store — Backend Environment Variables
#  Copy this file to .env and fill in your real values:
#      cp .env.example .env
#  NEVER commit the real .env file to Git.
# ─────────────────────────────────────────────────────────────


# ── Server ───────────────────────────────────────────────────
# Port your Express API runs on
PORT=5000

# URL of your React frontend (used for CORS)
CLIENT_URL=http://localhost:5173


# ── Database ─────────────────────────────────────────────────
# Local MongoDB
MONGO_URI=mongodb+srv://syedulhaq123mansoor_db_user:PHmHJKPYWvVvGabp@cluster0.ezz49pe.mongodb.net/CareBabyStore-baby-store

# Or MongoDB Atlas (cloud) — replace with your own connection string
# MONGO_URI=mongodb+srv://myuser:mypassword@cluster0.abc123.mongodb.net/CareBabyStore?retryWrites=true&w=majority


# ── Admin Authentication ─────────────────────────────────────
# Secret used to sign admin JWT tokens.
# Generate a long random string, e.g. with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=a3f9c8e12b7d6f4a9e3b5c8d1f2a7e6b9c4d8f3a1e7b2c5d9f6a3e8b1c4d7f2a

# Admin login credentials (change before going to production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123


# ── Store Configuration ──────────────────────────────────────
# These are also used by the seed script and order calculations
STORE_NAME=CareBabyStore Baby Store
WHATSAPP_NUMBER=919999999999


# ── Delivery & Pricing ───────────────────────────────────────
# Amount charged for delivery (in INR)
DELIVERY_FEE=49

# Order subtotal above which delivery is free (in INR)
FREE_DELIVERY_THRESHOLD=999





